generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase : pooler « Transaction » (port 6543, ?pgbouncer=true)
  directUrl = env("DIRECT_URL") // Supabase : connexion directe / « Session » (port 5432), utilisée par les migrations
}

// ─────────────────────────────── Utilisateurs & rôles ───────────────────────────────

enum Role {
  ADMIN // Super administrateur Skillio : gère la plateforme et tous les organismes
  OF_ADMIN // Responsable d'organisme de formation : gère son OF, ses dossiers, ses formations et son équipe
  TRAINER // Formateur rattaché à un OF : crée ses formations, quiz, grilles et évalue
  LEARNER // Apprenant : candidate et suit les formations
}

/// Statut du compte apprenant sur la plateforme (validation par l'OF avant tout accès)
enum AccountStatus {
  PENDING_PROFILE // Informations administratives à compléter (ou compléments demandés par l'OF)
  PENDING_REVIEW // Dossier de compte envoyé, en attente de validation par l'OF
  ACTIVE // Compte validé
  REJECTED // Inscription à la plateforme refusée
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String
  passwordHash        String
  sessionVersion      Int           @default(0) // Incrémenté à chaque changement de mot de passe : invalide les sessions ouvertes
  role                Role          @default(LEARNER)
  active              Boolean       @default(true)
  bio                 String?
  lastLoginAt         DateTime?
  phone               String?
  organizationId      String? // OF d'appartenance (équipe OF) ou OF d'inscription (apprenant)
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  failedLogins        Int           @default(0)
  lockedUntil         DateTime?
  consentAt           DateTime? // Acceptation CGU / politique de confidentialité
  deletionRequestedAt DateTime?

  // Validation du compte (apprenants) — les comptes équipe sont ACTIVE d'office
  accountStatus       AccountStatus @default(ACTIVE)
  createdVia          String        @default("SELF") // SELF (auto-inscription), OF (créé par l'organisme), ADMIN, SEED
  accountSubmittedAt  DateTime?
  accountReviewedAt   DateTime?
  accountReviewedById String?
  accountReviewedBy   User?         @relation("AccountReviewer", fields: [accountReviewedById], references: [id], onDelete: SetNull)
  accountReviewNote   String?       @db.Text // Motif de refus ou compléments demandés
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  profile                LearnerProfile?
  applications           Application[]          @relation("ApplicationLearner")
  reviewedApplications   Application[]          @relation("ApplicationReviewer")
  applicationEvents      ApplicationEvent[]
  reviewedDocuments      ApplicationDocument[]
  loginEvents            LoginEvent[]
  resetTokens            PasswordResetToken[]
  pedagogicalMessages    PedagogicalMessage[]
  activitySessions       ActivitySession[]
  timeLogs               TimeLog[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  signatures             AttendanceSignature[]
  satisfactions          SatisfactionResponse[]
  complaints             Complaint[]            @relation("ComplaintAuthor")
  handledComplaints      Complaint[]            @relation("ComplaintHandler")
  enrollmentsCreated     Enrollment[]           @relation("EnrolledBy")
  coursesAuthored        Course[]               @relation("CourseAuthor")
  coTeaching             CourseTrainer[]
  enrollments            Enrollment[]           @relation("EnrollmentLearner")
  lessonProgress         LessonProgress[]
  quizAttempts           QuizAttempt[]
  submissions            Submission[]           @relation("SubmissionLearner")
  gradedSubmissions      Submission[]           @relation("SubmissionGrader")
  rubrics                Rubric[]
  certificates           Certificate[]
  reviewedAccounts       User[]                 @relation("AccountReviewer")
  learnerDocuments       LearnerDocument[]      @relation("DocumentOwner")
  uploadedDocuments      LearnerDocument[]      @relation("DocumentUploader")
  reviewedLearnerDocs    LearnerDocument[]      @relation("DocumentReviewer")
  accessDecisions        Enrollment[]           @relation("AccessDecider")
  supportConversations   SupportConversation[]  @relation("SupportRequester")
  assignedSupport        SupportConversation[]  @relation("SupportAssignee")
  supportMessages        SupportMessage[]
  ticketsRequested       SupportTicket[]        @relation("TicketRequester")
  ticketsAssigned        SupportTicket[]        @relation("TicketAssignee")
  ticketMessages         SupportTicketMessage[]
  supportReferentOf      Organization[]         @relation("OrgSupportReferent")
  profileChangeRequests  ProfileChangeRequest[] @relation("ChangeRequester")
  reviewedChangeRequests ProfileChangeRequest[] @relation("ChangeReviewer")
}

model Setting {
  key   String @id
  value String
}

// ─────────────────────────────── Formations ───────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentPolicy {
  OPEN // Inscription libre depuis le catalogue
  APPLICATION // Candidature avec dossier, vérifiée puis validée par l'OF
  INVITE // Inscription uniquement par l'OF
}

enum TrainingModality {
  FOAD // Formation ouverte et à distance
  PRESENTIEL
  MIXTE // Blended learning
}

model Course {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  subtitle           String?
  description        String?          @db.Text
  objectives         String?          @db.Text
  prerequisites      String?          @db.Text
  audience           String?          @db.Text
  category           String?
  level              CourseLevel      @default(BEGINNER)
  durationHours      Float?
  coverUrl           String?
  status             CourseStatus     @default(DRAFT)
  enrollmentPolicy   EnrollmentPolicy @default(INVITE)
  sequential         Boolean          @default(true) // Parcours étape par étape : chaque leçon débloque la suivante
  certificateEnabled Boolean          @default(true)
  passingScore       Int              @default(70) // % moyen minimum aux quiz notés pour valider la formation
  authorId           String
  author             User             @relation("CourseAuthor", fields: [authorId], references: [id])
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  modality           TrainingModality @default(FOAD)
  rncpCode           String? // Code RNCP / RS de la certification visée
  cpfEligible        Boolean          @default(false)
  price              Float? // Tarif HT
  requiredDocuments  String[]         @default([]) // Justificatifs exigés pour candidater (vide = réglage de l'OF)
  skills             String[]         @default([]) // Compétences visées (positionnement d'entrée / de sortie)
  evaluationMethods  String?          @db.Text // Modalités d'évaluation (programme)
  pedagogicalMethods String?          @db.Text // Méthodes et moyens pédagogiques (programme)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  sessions     TrainingSession[]
  applications Application[]
  timeLogs     TimeLog[]
  complaints   Complaint[]
  trainers     CourseTrainer[]
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
  rubrics      Rubric[]
}

model CourseTrainer {
  courseId String
  userId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons   Lesson[]
  resources Resource[]

  @@index([courseId, position])
}

enum LessonType {
  INTERACTIVE // Module interactif HTML (URL intégrée ou HTML importé)
  CONTENT // Contenu texte (Markdown)
  VIDEO // Vidéo (YouTube, Vimeo, MP4…)
  QUIZ // Quiz noté / auto-évaluation
  ASSIGNMENT // Devoir / mise en situation évalué(e) avec une grille
  RESOURCE // Ressource téléchargeable / lien
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  summary     String?    @db.Text
  type        LessonType @default(CONTENT)
  position    Int
  durationMin Int?
  minTimeSec  Int? // Temps minimum de consultation avant de pouvoir valider l'étape (traçabilité FOAD)
  required    Boolean    @default(true)
  published   Boolean    @default(true)

  content        String?        @db.Text // Markdown (CONTENT, consignes ASSIGNMENT, description RESOURCE…)
  embedUrl       String? // INTERACTIVE : URL du module interactif
  htmlContent    String?        @db.Text // INTERACTIVE : HTML importé (servi en bac à sable)
  completionMode CompletionMode @default(MANUAL)
  videoUrl       String?
  resourceUrl    String?

  rubricId String? // ASSIGNMENT : grille d'évaluation utilisée
  rubric   Rubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz        Quiz?
  progress    LessonProgress[]
  submissions Submission[]
  timeLogs    TimeLog[]

  @@index([moduleId, position])
}

enum CompletionMode {
  MANUAL // L'apprenant clique "Marquer comme terminé"
  AUTO // Le module interactif signale la fin via postMessage (lms-bridge.js)
  ON_VIEW // Terminé dès l'ouverture
}

// ─────────────────────────────── Quiz ───────────────────────────────

enum QuestionType {
  SINGLE // QCM à réponse unique
  MULTIPLE // QCM à réponses multiples
  TRUE_FALSE // Vrai / Faux
  SHORT // Réponse courte (correction automatique par mots acceptés)
  OPEN // Question ouverte (correction manuelle par le formateur)
}

model Quiz {
  id               String  @id @default(cuid())
  lessonId         String  @unique
  lesson           Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  instructions     String? @db.Text
  passingScore     Int     @default(70)
  maxAttempts      Int? // null = illimité
  timeLimitMin     Int?
  shuffleQuestions Boolean @default(false)
  showCorrection   Boolean @default(true)
  graded           Boolean @default(true) // Compte dans la validation de la formation

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id              String           @id @default(cuid())
  quizId          String
  quiz            Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type            QuestionType
  text            String           @db.Text
  explanation     String?          @db.Text
  points          Float            @default(1)
  position        Int
  acceptedAnswers String[]         @default([]) // SHORT
  options         QuestionOption[]
  answers         Answer[]

  @@index([quizId, position])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int
}

enum AttemptStatus {
  IN_PROGRESS
  PENDING_REVIEW // Contient des questions ouvertes à corriger
  GRADED
}

model QuizAttempt {
  id          String        @id @default(cuid())
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Float         @default(0)
  maxScore    Float         @default(0)
  percent     Float         @default(0)
  passed      Boolean       @default(false)
  feedback    String?       @db.Text

  answers Answer[]

  @@index([quizId, userId])
}

model Answer {
  id                String      @id @default(cuid())
  attemptId         String
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]    @default([])
  text              String?     @db.Text
  pointsAwarded     Float       @default(0)
  isCorrect         Boolean?
  needsReview       Boolean     @default(false)
  feedback          String?     @db.Text

  @@unique([attemptId, questionId])
}

// ─────────────────────────────── Grilles d'évaluation ───────────────────────────────

model Rubric {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.Text
  courseId     String? // null = grille réutilisable dans toutes les formations
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  passingScore Int      @default(50) // % minimum pour valider
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  criteria RubricCriterion[]
  lessons  Lesson[]
}

model RubricCriterion {
  id          String  @id @default(cuid())
  rubricId    String
  rubric      Rubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  title       String
  description String? @db.Text
  weight      Float   @default(1)
  position    Int

  levels RubricLevel[]
  scores RubricScore[]
}

model RubricLevel {
  id          String          @id @default(cuid())
  criterionId String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  label       String // ex : Insuffisant, À améliorer, Satisfaisant, Excellent
  description String?         @db.Text
  points      Float
  position    Int

  scores RubricScore[]
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  NEEDS_REVISION
}

model Submission {
  id          String           @id @default(cuid())
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("SubmissionLearner", fields: [userId], references: [id], onDelete: Cascade)
  text        String?          @db.Text
  linkUrl     String?
  fileName    String?
  fileData    Bytes?
  fileType    String?
  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())
  score       Float?
  maxScore    Float?
  percent     Float?
  passed      Boolean?
  feedback    String?          @db.Text
  gradedAt    DateTime?
  gradedById  String?
  gradedBy    User?            @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  rubricScores RubricScore[]

  @@index([lessonId, userId])
}

model RubricScore {
  id           String          @id @default(cuid())
  submissionId String
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  levelId      String?
  level        RubricLevel?    @relation(fields: [levelId], references: [id], onDelete: SetNull)
  points       Float           @default(0)
  comment      String?         @db.Text

  @@unique([submissionId, criterionId])
}

// ─────────────────────────────── Inscriptions & progression ───────────────────────────────

/// Accès effectif au parcours (distinct du statut pédagogique)
enum AccessStatus {
  PENDING_DOCUMENTS // Documents d'inscription à fournir
  UNDER_REVIEW // Documents envoyés, en attente de validation par l'OF
  GRANTED // Accès ouvert
  REFUSED // Accès refusé par l'OF
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED // Interruption temporaire
  ABANDONED // Abandon / sortie anticipée
}

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation("EnrollmentLearner", fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  lastActivityAt DateTime?

  // Inscription définitive (contractualisation)
  applicationId    String?          @unique
  application      Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  sessionId        String?
  session          TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  fundingType      FundingType?
  fundingReference String? // N° dossier CPF / AIF / prise en charge OPCO
  startDate        DateTime?
  endDate          DateTime?
  plannedHours     Float? // Durée prévue (heures) pour le certificat de réalisation
  enrolledById     String?
  enrolledBy       User?            @relation("EnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)

  // Sortie anticipée (abandon, interruption) — exigée par les OPCO / France Travail
  exitDate     DateTime?
  exitCategory String? // Code motif (voir EXIT_REASONS)
  exitReason   String?   @db.Text

  // Convention / contrat de formation signé électroniquement par l'apprenant
  conventionSignedAt  DateTime?
  conventionSignature String?   @db.Text
  conventionSignedIp  String?
  convocationSentAt   DateTime?

  // Auto-évaluation de sortie sur les compétences visées (positionnement de sortie)
  exitAssessment Json?

  // Accès au parcours : documents d'inscription (convention signée, CGV, règlement intérieur…) validés par l'OF
  accessStatus       AccessStatus      @default(PENDING_DOCUMENTS)
  origin             String            @default("OF") // OF (inscrit par l'organisme), APPLICATION (candidature), SELF (demande directe)
  accessSubmittedAt  DateTime? // Dossier d'accès envoyé par l'apprenant
  accessDecidedAt    DateTime?
  accessDecidedById  String?
  accessDecidedBy    User?             @relation("AccessDecider", fields: [accessDecidedById], references: [id], onDelete: SetNull)
  accessDecisionNote String?           @db.Text
  accessRequestNote  String?           @db.Text // Compléments demandés par l'OF sur le dossier d'inscription
  accessRequestAt    DateTime?
  documents          LearnerDocument[]

  satisfactions SatisfactionResponse[]
  messages      PedagogicalMessage[]
  feedbacks     FunderFeedback[]

  @@unique([userId, courseId])
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       ProgressStatus @default(IN_PROGRESS)
  score        Float? // score remonté par le module interactif (0-100)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  timeSpentSec Int            @default(0)

  @@unique([userId, lessonId])
}

model Certificate {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt   DateTime @default(now())
  finalScore Float?

  @@unique([userId, courseId])
}

// ─────────────────────────────── Organismes de formation ───────────────────────────────

model Organization {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  name                  String // Nom commercial
  legalName             String? // Raison sociale
  siret                 String?
  nda                   String? // Numéro de déclaration d'activité
  ndaRegion             String? // Région / préfecture d'enregistrement
  qualiopiNumber        String?
  qualiopiDate          DateTime?
  address               String?
  postalCode            String?
  city                  String?
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?
  managerName           String? // Signataire des attestations
  managerTitle          String?
  internalRulesUrl      String? // Règlement intérieur
  cgvUrl                String?
  requiredDocuments     String[]  @default(["ID", "CV"]) // Justificatifs demandés par défaut
  inactivityTimeoutMin  Int       @default(15) // Minutes sans activité avant arrêt du chronomètre
  interactiveTimeoutMin Int       @default(45) // Idem quand l'apprenant travaille dans un module interactif (iframe)
  signatureImage        String?   @db.Text // Signature / cachet de l'OF (PNG data URL) apposé sur les documents
  referentHandicap      String? // Nom / contact du référent handicap
  mediatorInfo          String?   @db.Text // Médiateur de la consommation (contrats particuliers)
  cgvText               String?   @db.Text // Conditions générales de vente (signées en ligne par l'apprenant)
  internalRulesText     String?   @db.Text // Règlement intérieur (signé en ligne par l'apprenant)

  // Inscription à la plateforme
  requireAccountValidation Boolean  @default(true) // Les comptes apprenants doivent être validés par l'OF
  accountRequiredDocuments String[] @default(["ID"]) // Pièces demandées à la création du compte
  allowSelfRegistration    Boolean  @default(true) // L'OF apparaît dans la liste d'auto-inscription

  // Accès aux parcours
  enrollmentRequiredDocuments String[] @default(["CONVENTION", "CGV", "INTERNAL_RULES"])
  autoGrantAccess             Boolean  @default(false) // Ouvrir l'accès dès que toutes les pièces sont validées

  // Chat d'assistance
  supportEnabled       Boolean  @default(true)
  supportHours         String? // ex. « Du lundi au vendredi, 9 h – 18 h »
  supportResponseHours Int      @default(24) // Engagement de délai de première réponse (heures ouvrées)
  supportAutoReply     String?  @db.Text // Message automatique à l'ouverture d'une conversation
  // Support Vylia : interlocuteur de l'OF pour les tickets avec l'administrateur
  supportReferentId    String?
  supportReferent      User?    @relation("OrgSupportReferent", fields: [supportReferentId], references: [id], onDelete: SetNull)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                User[]
  feedbacks            FunderFeedback[]
  learnerDocuments     LearnerDocument[]
  supportConversations SupportConversation[]
  supportTickets       SupportTicket[]
  courses              Course[]
  auditLogs            AuditLog[]
  complaints           Complaint[]
}

// ─────────────────────────────── Dossier apprenant & candidatures ───────────────────────────────

enum EmploymentStatus {
  JOB_SEEKER // Demandeur d'emploi
  EMPLOYEE // Salarié
  SELF_EMPLOYED // Indépendant / chef d'entreprise
  STUDENT
  CIVIL_SERVANT // Agent public
  OTHER
}

enum FundingType {
  CPF
  OPCO
  FRANCE_TRAVAIL // AIF / financement France Travail
  EMPLOYER // Plan de développement des compétences
  REGION
  PERSONAL // Financement personnel
  OTHER
}

model LearnerProfile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  civility             String? // M. / Mme
  firstName            String?
  lastName             String?
  birthName            String?
  birthDate            DateTime?
  birthPlace           String?
  nationality          String?
  address              String?
  postalCode           String?
  city                 String?
  country              String?           @default("France")
  phone                String?
  employmentStatus     EmploymentStatus?
  franceTravailId      String? // Identifiant France Travail
  franceTravailAgency  String?
  educationLevel       String? // Niveau (3 à 8)
  lastDiploma          String?
  currentJob           String?
  employerName         String?
  employerSiret        String?
  employerAddress      String?
  employerContactName  String?
  employerContactEmail String?
  employerContactPhone String?
  opcoName             String?
  disability           Boolean           @default(false) // RQTH / situation de handicap
  disabilityNeeds      String?           @db.Text // Aménagements souhaités
  updatedAt            DateTime          @updatedAt
}

enum ApplicationStatus {
  DRAFT // En cours de saisie par l'apprenant
  SUBMITTED // Déposé, en attente de vérification
  UNDER_REVIEW // En cours d'instruction par l'OF
  INCOMPLETE // Compléments demandés à l'apprenant
  ACCEPTED // Validé par l'OF, en attente d'inscription définitive
  ENROLLED // Inscrit définitivement
  REJECTED // Refusé
  WITHDRAWN // Retiré par l'apprenant
}

model Application {
  id               String            @id @default(cuid())
  number           String            @unique // N° de dossier
  userId           String
  user             User              @relation("ApplicationLearner", fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionId        String?
  session          TrainingSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status           ApplicationStatus @default(DRAFT)
  fundingType      FundingType?
  fundingReference String?
  fundingDetails   String?           @db.Text
  motivation       String?           @db.Text
  expectations     String?           @db.Text
  experience       String?           @db.Text
  prerequisitesOk  Boolean           @default(false)
  availability     String?
  consentRgpd      Boolean           @default(false)
  consentTerms     Boolean           @default(false) // CGV + règlement intérieur
  consentAt        DateTime?
  positioning      Json? // Positionnement d'entrée : { compétence: niveau 0-4 }
  profileSnapshot  Json? // Copie du profil au moment du dépôt
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  decisionReason   String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  documents  ApplicationDocument[]
  events     ApplicationEvent[]
  enrollment Enrollment?

  @@index([courseId, status])
  @@index([userId])
}

enum DocumentStatus {
  PENDING
  VALIDATED
  REJECTED
}

model ApplicationDocument {
  id            String         @id @default(cuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // Code du justificatif (ID, CV, FT_ATTESTATION…)
  fileName      String
  fileType      String
  size          Int
  data          Bytes
  status        DocumentStatus @default(PENDING)
  comment       String?
  uploadedAt    DateTime       @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

enum ApplicationEventType {
  STATUS // Changement de statut
  MESSAGE // Message visible par l'apprenant
  NOTE // Note interne OF
  DOCUMENT // Dépôt / vérification de justificatif
}

model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type          ApplicationEventType
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  message       String?              @db.Text
  createdAt     DateTime             @default(now())

  @@index([applicationId, createdAt])
}

model TrainingSession {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  capacity  Int?
  location  String? // Lieu ou « À distance »
  open      Boolean  @default(true) // Ouverte aux candidatures
  createdAt DateTime @default(now())

  applications Application[]
  enrollments  Enrollment[]
  slots        AttendanceSlot[]
}

// ─────────────────────────────── Traçabilité (contrôles OPCO / France Travail / Qualiopi) ───────────────────────────────

enum LoginEventType {
  LOGIN
  LOGOUT
  FAILED
  LOCKED
}

model LoginEvent {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  type      LoginEventType
  ip        String?
  userAgent String?
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
}

/// Session de connexion effective (temps actif mesuré par battements de cœur, pauses d'inactivité exclues)
model ActivitySession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  endedAt       DateTime?
  activeSeconds Int       @default(0)
  ip            String?
  userAgent     String?

  timeLogs TimeLog[]

  @@index([userId, startedAt])
}

/// Temps actif passé sur une leçon, par segment continu
model TimeLog {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activitySessionId String?
  activitySession   ActivitySession? @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)
  startedAt         DateTime         @default(now())
  endedAt           DateTime         @default(now())
  seconds           Int              @default(0)

  @@index([userId, courseId, startedAt])
  @@index([lessonId])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String // ex : application.accept, enrollment.create, export.connections
  entityType     String?
  entityId       String?
  details        String?       @db.Text
  ip             String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// ─────────────────────────────── Émargement, satisfaction, réclamations ───────────────────────────────

model AttendanceSlot {
  id        String          @id @default(cuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date      DateTime // Jour
  label     String // Matin, Après-midi, Classe virtuelle…
  startTime String // "09:00"
  endTime   String // "12:30"
  createdAt DateTime        @default(now())

  signatures AttendanceSignature[]

  trainerName      String?
  trainerSignature String?   @db.Text
  trainerSignedAt  DateTime?

  @@index([sessionId, date])
}

model AttendanceSignature {
  id        String         @id @default(cuid())
  slotId    String
  slot      AttendanceSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  signature String         @db.Text // Image PNG (data URL) de la signature
  signedAt  DateTime       @default(now())
  ip        String?
  userAgent String?

  @@unique([slotId, userId])
}

model SatisfactionResponse {
  id           String     @id @default(cuid())
  kind         String     @default("HOT") // HOT = à chaud, COLD = à froid
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      Json // { questionCode: note 1-5 }
  globalScore  Float
  recommend    Boolean?
  comment      String?    @db.Text
  createdAt    DateTime   @default(now())

  @@unique([enrollmentId, kind])
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Complaint {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation("ComplaintAuthor", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  category       String // Réclamation, question pédagogique, technique, administrative…
  subject        String
  message        String          @db.Text
  status         ComplaintStatus @default(OPEN)
  response       String?         @db.Text
  handledById    String?
  handledBy      User?           @relation("ComplaintHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?
}

// ─────────────────────────────── Lot 2 ───────────────────────────────

/// Échanges apprenant ↔ formateur/OF pendant la formation (assistance pédagogique FOAD, art. D.6313-3-1)
model PedagogicalMessage {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromStaff    Boolean    @default(false)
  body         String     @db.Text
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId, createdAt])
}

/// Évaluation par un financeur ou une entreprise (Qualiopi indicateur 30), via lien sécurisé
model FunderFeedback {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollmentId   String?
  enrollment     Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  respondentType String // EMPLOYER, OPCO, FRANCE_TRAVAIL, OTHER
  respondentName String?
  answers        Json?
  globalScore    Float?
  comment        String?      @db.Text
  createdAt      DateTime     @default(now())
  answeredAt     DateTime?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─────────────────────────────── Lot 3 : comptes, accès, assistance ───────────────────────────────

/// Pièce du dossier apprenant : compte (identité…) ou inscription à un parcours (convention signée, CGV, règlement intérieur…)
model LearnerDocument {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  enrollmentId    String? // null = pièce de compte
  enrollment      Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type            String // Code (voir ACCOUNT_DOCUMENTS / ENROLLMENT_DOCUMENTS)
  source          String // LEARNER_UPLOAD, STAFF_UPLOAD, E_SIGNATURE
  // Fichier déposé
  fileName        String?
  fileType        String?
  size            Int?
  data            Bytes?
  // Signature électronique
  signature       String?        @db.Text // Image PNG de la signature
  signedIp        String?
  signedUserAgent String?
  contentHash     String? // Empreinte SHA-256 du texte signé (preuve de la version)
  signedContent   String?        @db.Text // Copie du texte signé (CGV, règlement intérieur) au moment de la signature
  // Revue
  status          DocumentStatus @default(PENDING)
  comment         String?
  uploadedById    String?
  uploadedBy      User?          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@index([userId, enrollmentId])
  @@index([organizationId, status])
}

enum SupportStatus {
  OPEN // En attente d'une réponse de l'équipe
  WAITING // Répondu, en attente de l'utilisateur
  RESOLVED
}

/// Chat d'assistance (technique, administratif, pédagogique, financement)
model SupportConversation {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation("SupportRequester", fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String? // OF qui traite ; null = support Vylia
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  category        String // TECH, ACCOUNT, ENROLLMENT, PEDAGOGY, FUNDING, OTHER
  subject         String
  status          SupportStatus    @default(OPEN)
  assignedToId    String?
  assignedTo      User?            @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastMessageAt   DateTime         @default(now())
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  rating          Int? // Satisfaction 1–5 après résolution
  createdAt       DateTime         @default(now())
  messages        SupportMessage[]

  @@index([organizationId, status, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStaff      Boolean             @default(false)
  system         Boolean             @default(false) // Message automatique
  body           String              @db.Text
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

// ─────────────────────────────── Support Vylia : tickets OF ↔ administrateur ───────────────────────────────

enum TicketStatus {
  OPEN // Nouveau, pas encore pris en charge
  IN_PROGRESS // Pris en charge par le support Vylia
  WAITING_OF // Réponse apportée, en attente de l'OF
  RESOLVED // Solution apportée, en attente de confirmation
  CLOSED // Clôturé
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Ticket d'assistance ouvert par le référent d'un OF auprès du support Vylia (administrateur)
model SupportTicket {
  id              String                 @id @default(cuid())
  number          String                 @unique // TCK-2026-00001
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User                   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedToId    String?
  assignedTo      User?                  @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  category        String // TECH, BUG, ACCOUNT, BILLING, FEATURE, COMPLIANCE, OTHER
  priority        TicketPriority         @default(NORMAL)
  status          TicketStatus           @default(OPEN)
  subject         String
  lastMessageAt   DateTime               @default(now())
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  rating          Int? // Satisfaction 1–5 à la clôture
  ratingComment   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  messages        SupportTicketMessage[]

  @@index([status, priority, lastMessageAt])
  @@index([organizationId, status, lastMessageAt])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromAdmin Boolean       @default(false)
  internal  Boolean       @default(false) // Note interne du support, invisible pour l'OF
  system    Boolean       @default(false) // Évènement automatique (changement de statut, assignation…)
  body      String        @db.Text
  fileName  String?
  fileType  String?
  size      Int?
  data      Bytes?
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ─────────────────────────────── Modification du profil apprenant ───────────────────────────────

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Une fois le compte validé, l'apprenant ne modifie plus ses informations : il en fait la demande à l'OF (anti-fraude)
model ProfileChangeRequest {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation("ChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  changes        Json // { champ: { from, to } }
  reason         String              @db.Text
  fileName       String? // Justificatif (pièce d'identité, justificatif de domicile…)
  fileType       String?
  size           Int?
  data           Bytes?
  status         ChangeRequestStatus @default(PENDING)
  reviewNote     String?             @db.Text
  reviewedById   String?
  reviewedBy     User?               @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([organizationId, status])
  @@index([userId, createdAt])
}

// ─────────────────────────────── Ressources pédagogiques ───────────────────────────────

/// Document ou lien mis à disposition dans un module : téléchargeable par l'apprenant dès qu'il a démarré le module
model Resource {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  url         String? // Lien externe (https)
  fileName    String?
  fileType    String?
  size        Int?
  data        Bytes?
  position    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([moduleId, position])
}
