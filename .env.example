# ── Base de données Supabase (projet « skillio-lms », région Paris) ──
# Supabase → Project Settings → Database → Connection string (remplacez [YOUR-PASSWORD])
# Pooler « Transaction » (port 6543) : utilisé par l'application (Vercel / serverless)
DATABASE_URL="postgresql://postgres.nzhnwcodxbngsjivzkmb:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Pooler « Session » (port 5432) : utilisé par `prisma migrate deploy`
DIRECT_URL="postgresql://postgres.nzhnwcodxbngsjivzkmb:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# En local avec PostgreSQL : mettez la même URL dans les deux variables
# DATABASE_URL="postgresql://lms:lms@localhost:5432/lms"
# DIRECT_URL="postgresql://lms:lms@localhost:5432/lms"

# Secret de signature des sessions (générez-le : openssl rand -base64 32)
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"

# Emails (facultatif) – https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Skillio <noreply@example.com>"
APP_URL="http://localhost:3000"

# Données de démo locales (npm run db:seed) : mot de passe des comptes créés
SEED_PASSWORD=""
